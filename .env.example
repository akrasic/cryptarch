# Copy to .env and fill in. Never commit the real .env.
#
# Both passwords below are required and compose will REFUSE to start without
# them (`:?` in docker-compose.yml). That is deliberate: a missing .env line
# becomes an empty string rather than an error, and an empty
# CRYPTARCH_ADMIN_PASSWORD used to bootstrap an admin with no password on a
# stack that otherwise came up green. The app now also rejects an empty or
# under-8-character value at boot.
POSTGRES_PASSWORD=change-me-strong
CRYPTARCH_ADMIN=admin
CRYPTARCH_ADMIN_PASSWORD=change-me-strong
CRYPTARCH_DEFAULT_QUOTA=3

# Where the WEB UI is published. Loopback by default, like every other port in
# this stack — this is the login form, the admin console and the one-time
# connection strings, so it is the last thing that should be on 0.0.0.0 by
# accident. Put a reverse proxy in front of it; set APP_BIND=0.0.0.0 only if
# you have decided to.
APP_BIND=127.0.0.1
APP_PORT=8080

# Session cookies carry Secure by default, so sign-in works ONLY over https://
# (or http://localhost). There is no TLS in this stack yet (CRYPTARCH-22).
#
# If you reach Cryptarch by plain http on a LAN address and leave this unset,
# LOGIN WILL SILENTLY FAIL: the browser discards the cookie, and you land back
# on the sign-in page exactly as though the password were wrong. The app logs a
# warning about this at startup. Set to 1 to accept the risk on a trusted
# network until TLS is in front.
#CRYPTARCH_INSECURE_COOKIES=1

# At-rest encryption key (host path). Generate once:
#   (umask 077; openssl rand -hex 32 > /srv/cryptarch/cryptarch.key)
#
# Keep it OUTSIDE the stack's git clone. It decrypts every backup blob and
# every stored managed-server admin DSN, so a key sitting next to the compose
# file is one `git add -A` from being published — and a key stored beside the
# blobs it opens defeats the point of sealing them.
CRYPTARCH_KEY_FILE_HOST=/srv/cryptarch/cryptarch.key

# The bouncer is the ONLY published database listener. Bind it to the
# private-network interface consumers use, not 0.0.0.0, unless you mean it.
BOUNCER_BIND=127.0.0.1
BOUNCER_PORT=6432

# The managed server Cryptarch provisions ONTO.
# Must be a role with CREATEDB CREATEROLE — NOT superuser in production.
# HOST/PORT are the ADVERTISED address baked into user connection strings —
# that must be the BOUNCER's published address (this host + BOUNCER_PORT
# when the managed server is this stack's own db), never raw Postgres.
CRYPTARCH_SEED_SERVER_DSN=postgres://cryptarch_admin:pw@db:5432/postgres
CRYPTARCH_SEED_SERVER_NAME=default
CRYPTARCH_SEED_SERVER_HOST=your-host-private-ip
CRYPTARCH_SEED_SERVER_PORT=6432

# Default "Allowed from" for newly provisioned databases. The compose default
# is the stack's own db network (containers attached to it), so an app
# container dropped onto the network reaches its database with zero CIDR
# knowledge. Widen to your LAN etc. per server in the admin settings.
#CRYPTARCH_SEED_SERVER_DEFAULT_CIDR=172.18.0.0/16
# Change together with the network subnet if 172.18.0.0/16 collides:
#DB_NETWORK_SUBNET=172.18.0.0/16

# In-stack dial address seeded as the "db network" listener (host:port as
# containers on the db network see it — service name + container port).
#CRYPTARCH_SEED_SERVER_STACK_LISTENER=bouncer:6432

# Health checks: sweep every N seconds (0 disables); alert on transitions
# via ntfy (topic URL) or a JSON webhook. Unset = audit-log only.
#CRYPTARCH_HEALTH_INTERVAL_SECS=60
#CRYPTARCH_NOTIFY_URL=https://ntfy.sh/your-private-topic
#CRYPTARCH_NOTIFY_FORMAT=ntfy

# Backups: host directory that receives encrypted per-database dumps.
# Sealed with cryptarch.key — back that key up OFF this machine or the blobs
# are unrecoverable.
#
# To actually DISABLE backups, set CRYPTARCH_BACKUP_DIR= (empty). Commenting
# out the _HOST line below only moves the host mount; it used to leave backups
# running against a path inside the stack directory while the docs claimed the
# feature was off.
CRYPTARCH_BACKUP_DIR_HOST=/srv/cryptarch/backups
#CRYPTARCH_BACKUP_DIR=
#CRYPTARCH_BACKUP_INTERVAL_SECS=86400
#CRYPTARCH_BACKUP_KEEP=7
#CRYPTARCH_BACKUP_STALE_AFTER_SECS=172800

# Prometheus scrape token (CRYPTARCH-98). Unset leaves /metrics returning 404.
#   openssl rand -hex 32
# Prometheus side:
#   scrape_configs:
#     - job_name: cryptarch
#       bearer_token: <the same value>
#       static_configs: [{ targets: ['cryptarch-host:8080'] }]
# Each scrape asks every managed server for its maintenance checks, so keep
# scrape_interval at 30s or more rather than the 5s some setups default to.
# Commented out because there is nothing useful to put here by default. Note
# that commenting it out and setting it empty are the SAME thing to the app:
# compose passes ${CRYPTARCH_METRICS_TOKEN:-} either way, and an empty token
# means /metrics answers 404. That fails closed, but if you wired up Prometheus
# and are getting 404s, an unset token is the first thing to check.
#CRYPTARCH_METRICS_TOKEN=

# Prometheus exporters shipped in the stack (postgres-exporter for the metadata
# database, pgbouncer-exporter for the edge). Both bind to localhost by default
# — set METRICS_BIND to the private-network interface if Prometheus runs on
# another host.
#METRICS_BIND=127.0.0.1
#PG_EXPORTER_PORT=9187
#BOUNCER_EXPORTER_PORT=9127
# The bouncer's console credentials. BOTH are required — compose refuses to
# start without them, and bouncer-init GENERATES userlist.txt from these on
# first deploy, so no console password exists anywhere in this repo.
#
#   pgbadmin — full console: RELOAD, KILL, SHUTDOWN. Cryptarch uses this.
#   pgbstats — SHOW STATS/POOLS/LISTS only. The metrics exporter uses this.
#
# Generate: openssl rand -hex 24
BOUNCER_ADMIN_PASSWORD=change-me-console-password
BOUNCER_STATS_PASSWORD=change-me-stats-password

# The stack-internal network. Its subnet is pinned because the bouncer's admin
# console is scoped to it — tenants live on the db network above and must not
# be able to reach the console. Change this and nothing else needs touching;
# CRYPTARCH_CONSOLE_CIDR follows it in docker-compose.yml.
#
# Change it if `docker compose up` says "Pool overlaps with other one on this
# address space" — docker allocates 172.17, 172.18, 172.19 … in order, so this
# default collides on a host already running a few compose stacks.
#BACKEND_NETWORK_SUBNET=172.19.0.0/16
